# Dokploy Environment Variables Template
# Copy these to your Dokploy service environment variables

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=evershop
DB_USER=admin
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Session Configuration (CRITICAL: Generate a secure random string)
# Generate using: openssl rand -base64 32
SESSION_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_32_CHARS

# Node Environment
NODE_ENV=production

# Domain Configuration
BASE_URL=https://yourdomain.com

# Optional: Email Configuration
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# SMTP_FROM_NAME=Your Store Name

# Optional: Payment Gateways
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# PAYPAL_CLIENT_ID=your_client_id
# PAYPAL_CLIENT_SECRET=your_client_secret
# PAYPAL_MODE=live

# Optional: AWS S3 Storage
# FILE_STORAGE=s3
# AWS_S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
